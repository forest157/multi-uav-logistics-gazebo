#!/usr/bin/env python3
"""Summarize confidence, occlusion and ID continuity fields from a mission CSV."""
import argparse
import csv
import json
from logistics_gazebo_sim.track_metrics import summarize_recorded_rows


def main():
    parser=argparse.ArgumentParser();parser.add_argument("csv");parser.add_argument("--json")
    args=parser.parse_args()
    with open(args.csv,newline="",encoding="utf-8") as stream:report=summarize_recorded_rows(csv.DictReader(stream))
    text=json.dumps(report,ensure_ascii=False,indent=2,sort_keys=True)
    if args.json:
        with open(args.json,"w",encoding="utf-8") as stream:stream.write(text+"\n")
    print(text)


if __name__=="__main__":main()
