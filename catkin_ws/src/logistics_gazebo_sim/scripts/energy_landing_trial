#!/usr/bin/env python3
"""Verify limited energy-priority landing targets without arming real aircraft."""
import json,os,time
import rospy
from geometry_msgs.msg import PoseStamped
from mavros_msgs.msg import State
from std_msgs.msg import String


class LandingTrial:
    def __init__(self):
        self.state={};self.targets=[None]*3
        self.states=[rospy.Publisher("/uav{}/mavros/state".format(i),State,queue_size=2) for i in range(3)]
        self.poses=[rospy.Publisher("/uav{}/mavros/local_position/pose".format(i),PoseStamped,queue_size=2) for i in range(3)]
        self.advisory=rospy.Publisher("/fleet/energy_return_advisory",String,queue_size=2)
        rospy.Subscriber("/fleet/mission_state",String,self.state_cb,queue_size=5)
        for i in range(3):rospy.Subscriber("/uav{}/target_pose".format(i),PoseStamped,self.target_cb,callback_args=i,queue_size=2)
    def state_cb(self,msg):
        try:self.state=json.loads(msg.data)
        except ValueError:pass
    def target_cb(self,msg,index):self.targets[index]=msg.pose.position.z
    def run(self):
        deadline=time.time()+15.;captured=None
        while time.time()<deadline and not rospy.is_shutdown():
            for i in range(3):
                state=State();state.connected=True;state.armed=True;state.mode="OFFBOARD";self.states[i].publish(state)
                pose=PoseStamped();pose.pose.position.z=8.;self.poses[i].publish(pose)
            self.advisory.publish(json.dumps({"landing_order":["uav2","uav1","uav0"]}))
            execution=self.state.get("energy_return_execution") or {}
            if self.state.get("phase")=="HOME_DESCENT" and execution.get("control_applied") and all(value is not None for value in self.targets):
                if self.targets[2]<self.targets[1]<self.targets[0]:captured=list(self.targets);break
            rospy.sleep(.02)
        result={"home_descent_reached":self.state.get("phase")=="HOME_DESCENT","control_applied":bool((self.state.get("energy_return_execution") or {}).get("control_applied")),
            "priority_order_observed":captured is not None,"target_altitudes":captured or self.targets}
        result["pass"]=all(result[key] for key in ("home_descent_reached","control_applied","priority_order_observed"));return result


if __name__=="__main__":
    rospy.init_node("energy_landing_trial");path=rospy.get_param("~report_path","");report=LandingTrial().run()
    rendered=json.dumps(report,sort_keys=True,indent=2)
    if path:
        directory=os.path.dirname(os.path.abspath(path))
        if not os.path.isdir(directory):os.makedirs(directory)
        with open(path,"w") as stream:stream.write(rendered+"\n")
    rospy.loginfo("energy landing report: %s",json.dumps(report,sort_keys=True))
    if not report["pass"]:raise SystemExit(1)
