#!/usr/bin/env python3
"""Transform per-UAV Gazebo block-laser clouds into the shared world frame."""
import math
from collections import deque
from threading import RLock
from logistics_gazebo_sim.lidar_alignment import select_pose, valid_return
from logistics_gazebo_sim.pointcloud_perception import exclude_near_vehicles
import rospy
from geometry_msgs.msg import PoseStamped
from sensor_msgs.msg import PointCloud, PointCloud2
from sensor_msgs import point_cloud2
from std_msgs.msg import Header


def rotate(point, quaternion):
    x,y,z=point;qx,qy,qz,qw=quaternion
    tx=2.0*(qy*z-qz*y);ty=2.0*(qz*x-qx*z);tz=2.0*(qx*y-qy*x)
    return (x+qw*tx+(qy*tz-qz*ty),y+qw*ty+(qz*tx-qx*tz),z+qw*tz+(qx*ty-qy*tx))


class LidarCloudAggregator:
    def __init__(self):
        self.count=int(rospy.get_param("~vehicle_count",3));sx=float(rospy.get_param("~spawn_x",-40.0));sy=float(rospy.get_param("~spawn_y",-40.0));spacing=float(rospy.get_param("~spawn_spacing_m",3.3));middle=(self.count-1)*0.5
        self.origins=[(sx+(i-middle)*spacing,sy) for i in range(self.count)]
        self.poses=[deque(maxlen=100) for _ in range(self.count)];self.clouds=[None]*self.count
        self.consumed=[0.0]*self.count;self.lock=RLock()
        self.publisher=rospy.Publisher("/perception/lidar_points",PointCloud2,queue_size=1)
        for index in range(self.count):
            rospy.Subscriber("/uav{}/mavros/local_position/pose".format(index),PoseStamped,self.pose_cb,index,queue_size=1)
            rospy.Subscriber("/uav{}/lidar/points".format(index),PointCloud,self.cloud_cb,index,queue_size=1)
        rospy.Timer(rospy.Duration(0.2),self.publish)

    def pose_cb(self,message,index):
        with self.lock:
            stamp=message.header.stamp.to_sec()
            if self.poses[index] and stamp < self.poses[index][-1][0]:
                self.poses[index].clear();self.clouds[index]=None;self.consumed[index]=0.0
                self.last_stamp=0.0
            self.poses[index].append((stamp,message.pose))

    def cloud_cb(self,message,index):
        with self.lock:self.clouds[index]=message

    def publish(self,_event):
        with self.lock:self.publish_locked()

    def publish_locked(self):
        now=rospy.Time.now();points=[]
        matched=[]
        for index,item in enumerate(self.clouds):
            if item is None:continue
            stamp=item.header.stamp.to_sec()
            pose=select_pose(self.poses[index],stamp,now.to_sec(),self.consumed[index])
            if pose is None:continue
            matched.append((index,stamp,pose))
        if not matched:return
        for index,stamp,pose in matched:
            item=self.clouds[index]
            q=pose.orientation;quaternion=(q.x,q.y,q.z,q.w);origin=self.origins[index]
            # Peer-body echoes belong to scan time, not callback-time position.
            centers=[]
            for peer,history in enumerate(self.poses):
                body=select_pose(history,stamp,now.to_sec(),0.0)
                if body is not None:
                    centers.append((body.position.x+self.origins[peer][0],
                                    body.position.y+self.origins[peer][1],body.position.z))
            scan_points=[]
            for raw in item.points:
                if not valid_return((raw.x,raw.y,raw.z)):continue
                x,y,z=rotate((raw.x,raw.y,raw.z+0.18),quaternion)
                scan_points.append((x+pose.position.x+origin[0],y+pose.position.y+origin[1],z+pose.position.z))
            points.extend(exclude_near_vehicles(scan_points,centers,1.0))
        for index,stamp,pose in matched:self.consumed[index]=stamp
        stamp=max(s for i,s,p in matched)
        if stamp <= getattr(self,'last_stamp',0.0):return
        self.last_stamp=stamp
        self.publisher.publish(point_cloud2.create_cloud_xyz32(Header(stamp=rospy.Time.from_sec(stamp),frame_id="world"),points))

if __name__=="__main__":
    rospy.init_node("lidar_cloud_aggregator");LidarCloudAggregator();rospy.spin()
