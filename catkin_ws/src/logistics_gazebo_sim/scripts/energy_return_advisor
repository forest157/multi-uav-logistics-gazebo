#!/usr/bin/env python3
"""Publish energy-aware return advice without commanding the aircraft."""
import json,os
import rospy,rospkg,yaml
from geometry_msgs.msg import PoseStamped
from std_msgs.msg import String
from logistics_gazebo_sim.energy_return_policy import EnergyReturnPolicy
from logistics_gazebo_sim.energy_return_policy import choose_alternate_landing_site
from logistics_gazebo_sim.clearance_analyzer import obstacle_primitives
from logistics_gazebo_sim.scenes import SCENES


def _safe_slots(values,minimum):
    if len(values)<2:return values
    closest=min(((sum((values[i][a]-values[j][a])**2 for a in range(3)))**.5) for i in range(len(values)) for j in range(i+1,len(values)))
    if closest<=0.:raise ValueError("home slots overlap")
    if closest>=minimum:return values
    center=tuple(sum(value[a] for value in values)/len(values) for a in range(3));scale=minimum/closest
    return [tuple(center[a]+scale*(value[a]-center[a]) for a in range(3)) for value in values]


class EnergyReturnAdvisor:
    def __init__(self):
        default=os.path.join(rospkg.RosPack().get_path("logistics_gazebo_sim"),"config","mission_scene0.yaml")
        with open(rospy.get_param("~mission_config",default),encoding="utf-8") as stream:self.config=yaml.safe_load(stream)
        self.count=int(rospy.get_param("~vehicle_count",self.config["vehicle_count"]))
        spacing=float(rospy.get_param("~spawn_spacing_m",3.3));middle=(self.count-1)*.5
        self.scene_id=int(rospy.get_param("~scene_id",0));self.origin=(float(rospy.get_param("~spawn_x",-40.)),float(rospy.get_param("~spawn_y",-40.)))
        if self.scene_id not in SCENES:raise ValueError("invalid scene_id")
        self.primitives=obstacle_primitives(SCENES[self.scene_id]);self.alternate=None
        self.spawn=[((i-middle)*spacing,0.,0.) for i in range(self.count)]
        formation=self.config.get("formation",{});self.minimum_separation=float(formation.get("minimum_separation_m",3.0))+float(formation.get("tracking_reserve_m",.3))
        self.home=_safe_slots([tuple(list(value)+[0.] if len(value)==2 else value) for value in self.config["initial_formation"]],self.minimum_separation)
        if len(self.home)!=self.count:raise ValueError("home formation must match vehicle_count")
        self.policy=EnergyReturnPolicy(rospy.get_param("~low_margin_wh",12.),rospy.get_param("~critical_margin_wh",0.),
            rospy.get_param("~release_hysteresis_wh",3.),rospy.get_param("~energy_stale_after_s",1.5))
        self.energy={};self.state={};self.poses=[None]*self.count
        rospy.Subscriber("/fleet/energy_state",String,self.energy_cb,queue_size=1)
        rospy.Subscriber("/fleet/mission_state",String,self.state_cb,queue_size=1)
        for i in range(self.count):rospy.Subscriber("/uav{}/mavros/local_position/pose".format(i),PoseStamped,self.pose_cb,callback_args=i,queue_size=1)
        self.publisher=rospy.Publisher("/fleet/energy_return_advisory",String,queue_size=2,latch=True)
    def energy_cb(self,msg):
        try:self.energy=json.loads(msg.data)
        except (TypeError,ValueError):self.energy={}
    def state_cb(self,msg):
        try:self.state=json.loads(msg.data)
        except (TypeError,ValueError):self.state={}
    def pose_cb(self,msg,index):
        p=msg.pose.position;self.poses[index]=(p.x+self.spawn[index][0],p.y+self.spawn[index][1],p.z)
    def report(self):
        positions=self.poses if all(value is not None for value in self.poses) else None
        result=self.policy.update(self.energy,rospy.get_time(),positions,self.home,str(self.state.get("phase","")),self.minimum_separation)
        result["safety_override_required"]=bool((self.state.get("safety_interlock") or {}).get("hold")) or str(self.state.get("dynamic_action",""))=="HOLD"
        phase=str(self.state.get("phase",""));critical=[value for value in result["vehicles"] if value["level"]=="CRITICAL"]
        if len(critical)==1 and positions and phase in ("CRUISE_REFORMATION","RETURN"):
            vehicle=int(critical[0]["vehicle_id"].replace("uav",""));world=[(p[0]+self.origin[0],p[1]+self.origin[1],p[2]) for p in positions]
            if self.alternate is None or self.alternate["vehicle_id"]!=critical[0]["vehicle_id"]:
                site=choose_alternate_landing_site(world[vehicle],[p for i,p in enumerate(world) if i!=vehicle],self.primitives,min_separation=self.minimum_separation)
                self.alternate=None if site is None else {"vehicle_id":critical[0]["vehicle_id"],"world_point":list(site),
                    "local_point":[site[0]-self.origin[0]-self.spawn[vehicle][0],site[1]-self.origin[1]-self.spawn[vehicle][1],site[2]]}
            result["alternate_landing"]=self.alternate
            if self.alternate is None:result["action"]="HOLD_RECOMMENDED"
        else:
            if not critical:self.alternate=None
            result["alternate_landing"]=None
            if len(critical)>1:result["action"]="HOLD_RECOMMENDED"
        result["mission_phase"]=phase;return result
    def run(self):
        rate=rospy.Rate(2)
        while not rospy.is_shutdown():self.publisher.publish(json.dumps(self.report(),separators=(",",":")));rate.sleep()


if __name__=="__main__":rospy.init_node("energy_return_advisor");EnergyReturnAdvisor().run()
