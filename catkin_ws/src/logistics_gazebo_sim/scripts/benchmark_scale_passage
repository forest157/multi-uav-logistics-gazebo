#!/usr/bin/env python3
"""Run 20–50 vehicle kinematic corridor scheduling pressure checks."""

import argparse
import json
from pathlib import Path

import rospkg

from logistics_gazebo_sim.outdoor_world_profile import load_outdoor_profile
from logistics_gazebo_sim.scale_passage import stress_passage


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--world', default='outdoor_scale_yard')
    parser.add_argument('--counts', type=int, nargs='+', default=[20, 35, 50])
    parser.add_argument('--output', type=Path)
    args = parser.parse_args()
    package = Path(rospkg.RosPack().get_path('logistics_gazebo_sim'))
    profile = load_outdoor_profile(args.world, str(package / 'worlds'))
    report = stress_passage(profile, args.counts)
    rendered = json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True) + '\n'
    if args.output:
        args.output.write_text(rendered, encoding='utf-8')
    print(rendered, end='')
    return 0 if report['passed'] else 1


if __name__ == '__main__':
    raise SystemExit(main())
