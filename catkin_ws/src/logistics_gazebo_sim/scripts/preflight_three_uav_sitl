#!/usr/bin/env python3
"""Check the current three-PX4 launch before starting Gazebo or MAVROS."""

import argparse
import json
from pathlib import Path
import rospkg

from logistics_gazebo_sim.sitl_preflight import preflight


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--world', default='scene_0',
                        choices=('scene_0', 'outdoor_campus',
                                 'outdoor_residential', 'outdoor_urban'))
    parser.add_argument('--world-dir', type=Path,
                        help='override the ROS package world directory')
    parser.add_argument('--vehicle-count', type=int, default=3)
    parser.add_argument('--gazebo-master-uri',
                        help='override the selected launch file default')
    args = parser.parse_args()
    world_dir = args.world_dir or Path(rospkg.RosPack().get_path('logistics_gazebo_sim')) / 'worlds'
    result = preflight(args.world, world_dir, args.vehicle_count,
                       args.gazebo_master_uri)
    print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
    return 0 if result['pass'] else 1


if __name__ == '__main__':
    raise SystemExit(main())
