#!/usr/bin/env python3
"""Track dynamic detections and publish the obstacle-state compatibility interface."""
import json
import rospy
from std_msgs.msg import String
from logistics_gazebo_sim.target_tracking import AlphaBetaTracker,TrackingError,validate_detection_payload


class TargetTrackerNode:
    def __init__(self):
        self.tracker=AlphaBetaTracker(rospy.get_param("~alpha",0.75),rospy.get_param("~beta",0.2),rospy.get_param("~maximum_age_s",1.0))
        self.publisher=rospy.Publisher("/perception/dynamic_tracks",String,queue_size=5)
        rospy.Subscriber("/perception/dynamic_detections",String,self.callback,queue_size=1)

    def callback(self,message):
        try:
            payload=validate_detection_payload(json.loads(message.data));tracks=self.tracker.update(payload["stamp"],payload["detections"])
            obstacles=[{key:track[key] for key in ("id","position","velocity","radius","height","confidence","observed")} for track in tracks]
            self.publisher.publish(json.dumps({"stamp":payload["stamp"],"frame_id":payload["frame_id"],
                "source":"perception","obstacles":obstacles},separators=(",",":")))
        except (TypeError,ValueError,KeyError,TrackingError) as error:
            rospy.logerr_throttle(2.0,"invalid dynamic detection: %s",error)

if __name__=="__main__":
    rospy.init_node("dynamic_target_tracker");TargetTrackerNode();rospy.spin()
