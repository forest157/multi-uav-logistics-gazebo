#!/usr/bin/env python3
"""Independent Gazebo-truth audit of a manually started scale mission."""

import argparse
import json
import math
import time

import rospy
from gazebo_msgs.msg import ModelStates
from mavros_msgs.msg import State
from std_srvs.srv import Trigger

from logistics_gazebo_sim.clearance_analyzer import horizontal_distance
from logistics_gazebo_sim.outdoor_world_profile import load_outdoor_profile


class Auditor:
    def __init__(self, count, profile):
        self.count = count
        self.profile = profile
        self.frames = 0
        self.min_separation = float('inf')
        self.min_static_clearance = float('inf')
        self.min_corridor_altitude = float('inf')
        self.max_corridor_altitude = -float('inf')
        self.armed = [None] * count
        self.phases = set()
        self.hazards = []
        rospy.Subscriber('/gazebo/model_states', ModelStates, self._models,
                         queue_size=1)
        for index in range(count):
            rospy.Subscriber('/uav{}/mavros/state'.format(index), State,
                             self._state, callback_args=index, queue_size=1)

    def _state(self, message, index):
        self.armed[index] = message.armed

    def _models(self, message):
        names = {name: index for index, name in enumerate(message.name)}
        if not all('iris{}'.format(i) in names for i in range(self.count)):
            return
        points = []
        for index in range(self.count):
            p = message.pose[names['iris{}'.format(index)]].position
            points.append((p.x, p.y, p.z))
        self.frames += 1
        for left in range(self.count):
            for right in range(left + 1, self.count):
                d = math.dist(points[left], points[right])
                self.min_separation = min(self.min_separation, d)
                if d < 2.7 and 'vehicle separation' not in self.hazards:
                    self.hazards.append('vehicle separation')
        for x, y, z in points:
            if abs(y) <= 55 and z > 4:
                self.min_corridor_altitude = min(self.min_corridor_altitude, z)
                self.max_corridor_altitude = max(self.max_corridor_altitude, z)
            for obstacle in self.profile['obstacles']:
                horizontal = horizontal_distance(obstacle, x, y) - 1.2
                vertical = z - 0.6 - obstacle['height']
                # A collision requires both horizontal and vertical overlap.
                clearance = max(horizontal, vertical)
                self.min_static_clearance = min(self.min_static_clearance,
                                                clearance)
                if clearance < 0 and 'static collision envelope' not in self.hazards:
                    self.hazards.append('static collision envelope')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--count', type=int, choices=(1, 3, 5, 8), required=True)
    parser.add_argument('--output', required=True)
    parser.add_argument('--timeout', type=float, default=1800.0)
    args = parser.parse_args()
    rospy.init_node('scale_flight_auditor', anonymous=True)
    import rospkg
    package = rospkg.RosPack().get_path('logistics_gazebo_sim')
    profile = load_outdoor_profile('outdoor_scale_yard', package + '/worlds')
    auditor = Auditor(args.count, profile)
    status_service = rospy.ServiceProxy('/scale_group_controller/status', Trigger)
    started = time.monotonic()
    final_status = 'unavailable'
    final_fault = None
    phase_count = None
    rate = rospy.Rate(2)
    while not rospy.is_shutdown() and time.monotonic() - started < args.timeout:
        try:
            result = json.loads(status_service().message)
            final_status = result['status']
            final_fault = result['fault']
            phase_count = result['phase_count']
            auditor.phases.add(result['phase'])
            if final_status in ('complete', 'fault_hold'):
                break
        except (rospy.ServiceException, ValueError, KeyError):
            pass
        rate.sleep()
    covered = phase_count is not None and set(range(phase_count + 1)).issubset(auditor.phases)
    passed = (final_status == 'complete' and covered and auditor.frames >= 100 and
              not auditor.hazards and all(state is False for state in auditor.armed))
    report = {'passed': passed, 'vehicle_count': args.count,
              'status': final_status, 'fault': final_fault,
              'gazebo_truth_frames': auditor.frames,
              'observed_phases': sorted(auditor.phases),
              'all_phases_observed': covered,
              'min_separation_m': None if math.isinf(auditor.min_separation) else auditor.min_separation,
              'min_static_clearance_m': None if math.isinf(auditor.min_static_clearance) else auditor.min_static_clearance,
              'corridor_altitude_range_m': [None if math.isinf(auditor.min_corridor_altitude)
                                            else auditor.min_corridor_altitude,
                                            None if math.isinf(auditor.max_corridor_altitude)
                                            else auditor.max_corridor_altitude],
              'all_disarmed': all(state is False for state in auditor.armed),
              'hazards': auditor.hazards,
              'elapsed_wall_s': time.monotonic() - started}
    with open(args.output, 'w', encoding='utf-8') as stream:
        json.dump(report, stream, indent=2, sort_keys=True)
        stream.write('\n')
    print(json.dumps(report, sort_keys=True), flush=True)
    return 0 if passed else 1


if __name__ == '__main__':
    raise SystemExit(main())
