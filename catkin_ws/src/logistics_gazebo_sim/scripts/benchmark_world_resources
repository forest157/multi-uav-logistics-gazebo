#!/usr/bin/env python3
"""Measure an already running Gazebo world's empty-scene resource baseline."""
import argparse
import json
import os
import re
import subprocess
import time

import rospy
from gazebo_msgs.srv import GetWorldProperties


def process_sample(pid):
    with open('/proc/{}/stat'.format(pid), encoding='utf-8') as stream:
        stat = stream.read()
    # The process name in parentheses may contain spaces; indices below begin
    # at field 3 of proc(5), after the closing parenthesis.
    fields = stat[stat.rfind(')') + 2:].split()
    cpu_ticks = int(fields[11]) + int(fields[12])
    with open('/proc/{}/status'.format(pid), encoding='utf-8') as stream:
        status = stream.read()
    match = re.search(r'^VmRSS:\s+(\d+)\s+kB$', status, re.MULTILINE)
    if match is None:
        raise RuntimeError('gzserver RSS is unavailable')
    return cpu_ticks, int(match.group(1))


def matching_gzserver(world):
    token = os.path.basename(world)
    if not token.endswith('.world'):
        token += '.world'
    candidates = subprocess.check_output(['pgrep', '-x', 'gzserver']).split()
    matches = []
    for raw in candidates:
        pid = int(raw)
        # gazebo_ros starts a shell wrapper named gzserver before execing the
        # actual server; count only the executable, not both processes.
        executable = os.path.basename(os.readlink('/proc/{}/exe'.format(pid)))
        if executable != 'gzserver' and not executable.startswith('gzserver-'):
            continue
        with open('/proc/{}/cmdline'.format(pid), 'rb') as stream:
            arguments = stream.read().decode('utf-8', 'replace').split('\0')
        if any(os.path.basename(argument) == token for argument in arguments):
            matches.append(pid)
    if len(matches) != 1:
        raise RuntimeError('expected exactly one gzserver for {}'.format(token))
    return matches[0]


def measure(world, seconds):
    if not 1.0 <= seconds <= 60.0:
        raise ValueError('sample duration must be 1..60 seconds')
    rospy.init_node('world_resource_probe', anonymous=True, disable_signals=True)
    rospy.wait_for_service('/gazebo/get_world_properties', timeout=30.0)
    properties = rospy.ServiceProxy('/gazebo/get_world_properties', GetWorldProperties)
    pid = matching_gzserver(world)
    before = properties()
    if not before.success:
        raise RuntimeError(before.status_message)
    wall_start = time.monotonic()
    cpu_start, rss_start = process_sample(pid)
    time.sleep(seconds)
    after = properties()
    wall_end = time.monotonic()
    cpu_end, rss_end = process_sample(pid)
    if not after.success:
        raise RuntimeError(after.status_message)
    wall_elapsed = wall_end - wall_start
    sim_elapsed = after.sim_time - before.sim_time
    if sim_elapsed <= 0.0:
        raise RuntimeError('simulation clock did not advance')
    return {
        'world': world,
        'sample_wall_s': round(wall_elapsed, 3),
        'sample_sim_s': round(sim_elapsed, 3),
        'real_time_factor': round(sim_elapsed / wall_elapsed, 3),
        'gzserver_cpu_cores': round(
            (cpu_end - cpu_start) / os.sysconf('SC_CLK_TCK') / wall_elapsed, 3),
        'gzserver_rss_start_mib': round(rss_start / 1024.0, 1),
        'gzserver_rss_end_mib': round(rss_end / 1024.0, 1),
        'model_count': len(after.model_names),
        'gazebo_model_names': sorted(after.model_names),
        'host_cpu_count': os.cpu_count(),
        'scope': 'Gazebo server with no PX4, lidar, or mission nodes',
    }


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('world')
    parser.add_argument('--seconds', type=float, default=12.0)
    args = parser.parse_args()
    print(json.dumps(measure(args.world, args.seconds), indent=2))
