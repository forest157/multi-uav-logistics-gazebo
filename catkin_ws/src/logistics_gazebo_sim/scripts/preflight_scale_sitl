#!/usr/bin/env python3
"""Check 1/3/5/8 lightweight PX4 startup and corridor grouping."""

import argparse
import json
from pathlib import Path

import rospkg

from logistics_gazebo_sim.scale_launch import preflight_scale


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--count', type=int, required=True)
    parser.add_argument('--gazebo-master-uri')
    parser.add_argument('--output', type=Path)
    args = parser.parse_args()
    package = Path(rospkg.RosPack().get_path('logistics_gazebo_sim'))
    report = preflight_scale(args.count, package, args.gazebo_master_uri)
    rendered = json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True) + '\n'
    if args.output:
        args.output.write_text(rendered, encoding='utf-8')
    print(rendered, end='')
    return 0 if report['pass'] else 1


if __name__ == '__main__':
    raise SystemExit(main())
