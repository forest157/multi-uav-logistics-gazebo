#!/usr/bin/env python3
"""Isolated collective avoidance planner ROS worker."""
import json

import rospy
from std_msgs.msg import String

from logistics_gazebo_sim.local_avoidance import create_local_planner


class Planner:
    def __init__(self):
        self.algorithm=str(rospy.get_param("~algorithm","collective_offset"))
        self.pub=rospy.Publisher("/fleet/avoidance_plan",String,queue_size=1)
        rospy.Subscriber("/fleet/avoidance_request",String,self.callback,queue_size=1)

    def callback(self, message):
        payload={}
        try:
            payload=json.loads(message.data)
            options=dict(payload.get("options",{}))
            algorithm=options.pop("algorithm",self.algorithm)
            avoidance=create_local_planner(algorithm).plan(
                payload["paths"],payload["obstacles"],**options)
            result={"request_id":payload["request_id"],"avoidance":avoidance}
        except Exception as error:
            rospy.logerr("isolated avoidance planning failed: %s",error)
            avoidance={"viable":False,"selected_offset":None,
                "reason":"isolated avoidance planner failure",
                "candidates":[],"minimum_clearance_m":None,
                "rejection_summary":{"PLANNER_FAILURE":1}}
            result={"request_id":payload.get("request_id") if
                    isinstance(payload,dict) else None,"avoidance":avoidance}
        self.pub.publish(json.dumps(result,separators=(",",":")))


if __name__=="__main__":
    rospy.init_node("dynamic_avoidance_planner")
    Planner();rospy.spin()
