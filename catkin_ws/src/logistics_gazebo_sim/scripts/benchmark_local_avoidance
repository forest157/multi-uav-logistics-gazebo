#!/usr/bin/env python3
"""Deterministic offline comparison for local avoidance planners."""
import argparse,csv,json,math,time
import numpy as np
from logistics_gazebo_sim.dynamic_obstacles import assess_fleet_separation,assess_timed_path,interpolate_timed_path,shifted_path
from logistics_gazebo_sim.local_avoidance import create_local_planner

ALGORITHMS=("collective_offset","orca3d","distributed_mpc")

def scenario(index,count=3):
    phase=float(index%10)/9.0;start_x=0.15*index
    paths=[[[0.0,start_x,(vehicle-(count-1)*0.5)*4.0,8.0],[5.0,start_x+10.0,(vehicle-(count-1)*0.5)*4.0,8.0]] for vehicle in range(count)]
    obstacle={"id":"bird_{}".format(index),"position":[start_x+4.0+2.0*phase,-6.0+12.0*phase,8.0+0.8*math.sin(index)],"velocity":[0.0,-0.2+0.4*(index%3)/2.0,0.0],"radius":0.5,"height":0.8}
    return paths,[obstacle]

def predicted_paths(name,result,paths,horizon=3.0,dt=0.25):
    times=np.arange(0.0,horizon+1e-6,dt)
    if name=="distributed_mpc":return result.get("trajectories") or paths
    if name=="collective_offset":
        offset=result.get("selected_offset") or [0.0,0.0,0.0]
        return [shifted_path(path,offset) for path in paths]
    commands={item["vehicle_id"]:item for item in result.get("commands") or []};output=[]
    for vehicle,path in enumerate(paths):
        start=np.asarray(path[0][1:],dtype=float);velocity=np.asarray(commands.get("uav{}".format(vehicle),{}).get("velocity",[0,0,0]),dtype=float)
        output.append([[float(value)]+[float(axis) for axis in start+velocity*value] for value in times])
    return output

def trajectory_metrics(predicted,nominal,obstacles,horizon=3.0):
    separation=assess_fleet_separation(predicted,horizon=horizon,minimum_separation=3.0)
    reports=[assess_timed_path(path,obstacles,horizon=horizon,warning_clearance=0.5) for path in predicted]
    clearances=[value["minimum_clearance_m"] for value in reports if value["minimum_clearance_m"] is not None]
    deviation=[];energy=[];smoothness=[]
    for path,reference in zip(predicted,nominal):
        values=np.asarray(path,dtype=float);positions=values[:,1:];times=values[:,0]
        for stamp,position in zip(times,positions):deviation.append(float(np.linalg.norm(position-interpolate_timed_path(reference,min(float(reference[-1][0]),float(stamp))))))
        if len(values)>1:
            dt=np.maximum(1e-3,np.diff(times));velocity=np.diff(positions,axis=0)/dt[:,None];energy.extend(np.sum(velocity*velocity,axis=1).tolist())
            if len(velocity)>1:
                acceleration=np.diff(velocity,axis=0)/dt[1:,None];smoothness.extend(np.sum(acceleration*acceleration,axis=1).tolist())
    return {"minimum_separation_m":separation.get("minimum_separation_m"),"minimum_clearance_m":min(clearances) if clearances else None,"mean_deviation_m":float(np.mean(deviation)) if deviation else 0.0,"energy_proxy":float(np.mean(energy)) if energy else 0.0,"smoothness_proxy":float(np.mean(smoothness)) if smoothness else 0.0}

def run(cases):
    planners={name:create_local_planner(name) for name in ALGORITHMS};rows=[]
    for index in range(cases):
        paths,obstacles=scenario(index)
        for name in ALGORITHMS:
            started=time.perf_counter();result=planners[name].plan(paths,obstacles,horizon=3.0,minimum_separation=3.0,required_clearance=0.5,mpc_steps=6,mpc_dt=0.5,mpc_max_iterations=55);elapsed=1000.0*(time.perf_counter()-started)
            metrics=trajectory_metrics(predicted_paths(name,result,paths),paths,obstacles)
            rows.append(dict(case=index,algorithm=name,viable=bool(result.get("viable")),elapsed_ms=round(elapsed,3),rejections=result.get("rejection_summary") or {},solver_retries=sum(1 for item in result.get("commands") or [] if item.get("solver_retried")),warm_started=result.get("warm_started_vehicle_count",0),**metrics))
    summary={}
    for name in ALGORITHMS:
        values=[row for row in rows if row["algorithm"]==name];accepted=[row for row in values if row["viable"]];timings=sorted(row["elapsed_ms"] for row in values)
        summary[name]={"cases":len(values),"viable":sum(row["viable"] for row in values),"viable_rate":round(sum(row["viable"] for row in values)/float(len(values)),4),"mean_ms":round(float(np.mean(timings)),3),"p95_ms":timings[min(len(timings)-1,int(0.95*(len(timings)-1)))],"max_ms":max(timings),"mean_accepted_clearance_m":None if not accepted else round(float(np.mean([row["minimum_clearance_m"] for row in accepted if row["minimum_clearance_m"] is not None])),3),"minimum_accepted_separation_m":None if not accepted else round(min(row["minimum_separation_m"] for row in accepted if row["minimum_separation_m"] is not None),3),"mean_deviation_m":round(float(np.mean([row["mean_deviation_m"] for row in values])),3),"mean_energy_proxy":round(float(np.mean([row["energy_proxy"] for row in values])),3),"mean_smoothness_proxy":round(float(np.mean([row["smoothness_proxy"] for row in values])),3),"solver_retries":sum(row["solver_retries"] for row in values)}
    return rows,summary

def main():
    parser=argparse.ArgumentParser();parser.add_argument("--cases",type=int,default=30);parser.add_argument("--json",dest="json_path");parser.add_argument("--csv",dest="csv_path");args=parser.parse_args()
    if not 1<=args.cases<=500:parser.error("--cases must be 1..500")
    rows,summary=run(args.cases);print(json.dumps(summary,ensure_ascii=False,indent=2,sort_keys=True))
    if args.json_path:
        with open(args.json_path,"w",encoding="utf-8") as handle:json.dump({"summary":summary,"rows":rows},handle,ensure_ascii=False,indent=2)
    if args.csv_path:
        fields=["case","algorithm","viable","elapsed_ms","minimum_separation_m","minimum_clearance_m","mean_deviation_m","energy_proxy","smoothness_proxy","solver_retries","warm_started","rejections"]
        with open(args.csv_path,"w",newline="",encoding="utf-8") as handle:
            writer=csv.DictWriter(handle,fieldnames=fields);writer.writeheader()
            for row in rows:row=dict(row);row["rejections"]=json.dumps(row["rejections"],ensure_ascii=False,sort_keys=True);writer.writerow(row)
if __name__=="__main__":main()
