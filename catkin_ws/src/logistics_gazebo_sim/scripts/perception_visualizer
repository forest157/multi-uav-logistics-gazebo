#!/usr/bin/env python3
"""Render perceived dynamic tracks as bodies and velocity arrows in RViz."""
import json
import rospy
from geometry_msgs.msg import Point
from std_msgs.msg import String
from visualization_msgs.msg import Marker, MarkerArray


class PerceptionVisualizer:
    def __init__(self):
        self.publisher=rospy.Publisher("/perception/dynamic_markers",MarkerArray,queue_size=1,latch=True)
        rospy.Subscriber("/perception/dynamic_tracks",String,self.callback,queue_size=1)

    def callback(self,message):
        try: payload=json.loads(message.data)
        except (TypeError,ValueError):return
        frame=payload.get("frame_id","map");stamp=rospy.Time.now();markers=MarkerArray()
        clear=Marker();clear.header.frame_id=frame;clear.header.stamp=stamp;clear.action=Marker.DELETEALL;markers.markers.append(clear)
        for index,track in enumerate(payload.get("obstacles",[])):
            position=track["position"];velocity=track["velocity"]
            body=Marker();body.header.frame_id=frame;body.header.stamp=stamp;body.ns="perception_detection";body.id=index
            body.type=Marker.SPHERE;body.action=Marker.ADD;body.pose.orientation.w=1.0
            body.pose.position.x,body.pose.position.y,body.pose.position.z=position
            diameter=max(0.3,2.0*float(track.get("radius",0.5)));body.scale.x=diameter;body.scale.y=diameter;body.scale.z=max(0.3,float(track.get("height",0.5)))
            body.color.r=0.1;body.color.g=0.85;body.color.b=1.0;body.color.a=0.35 if track.get("observed",True) else 0.15;markers.markers.append(body)
            arrow=Marker();arrow.header=body.header;arrow.ns="perception_velocity";arrow.id=1000+index;arrow.type=Marker.ARROW;arrow.action=Marker.ADD
            arrow.points=[Point(*position),Point(*(p+v for p,v in zip(position,velocity)))]
            arrow.scale.x=0.12;arrow.scale.y=0.25;arrow.scale.z=0.25;arrow.color.r=1.0;arrow.color.g=0.65;arrow.color.b=0.05;arrow.color.a=0.95
            markers.markers.append(arrow)
        self.publisher.publish(markers)

if __name__=="__main__":
    rospy.init_node("perception_visualizer");PerceptionVisualizer();rospy.spin()
