#!/usr/bin/env python3
import argparse,json
from logistics_gazebo_sim.perception_acceptance import run_perception_acceptance_matrix

def main():
    parser=argparse.ArgumentParser();parser.add_argument("--output");args=parser.parse_args()
    report=run_perception_acceptance_matrix();rendered=json.dumps(report,sort_keys=True,indent=2)
    if args.output:
        with open(args.output,"w") as stream:stream.write(rendered+"\n")
    print(rendered);return 0 if report["pass"] else 1

if __name__=="__main__":raise SystemExit(main())
