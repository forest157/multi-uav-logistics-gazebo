#!/usr/bin/env python3
"""CLI for the v0.5.12 evidence gate; nonzero means release is not ready."""

import argparse
import json
from pathlib import Path

from logistics_gazebo_sim.series_acceptance import audit_manifest


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--repo', type=Path, default=Path('/home/devuser'))
    parser.add_argument('--manifest', default=(
        'reference/gazebo_3d_ros_package_experiment/'
        'v0512_series_acceptance/manifest.json'))
    parser.add_argument('--output', type=Path)
    args = parser.parse_args()
    with (args.repo / args.manifest).open(encoding='utf-8') as stream:
        manifest = json.load(stream)
    result = audit_manifest(args.repo, manifest)
    rendered = json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True) + '\n'
    if args.output:
        args.output.write_text(rendered, encoding='utf-8')
    print(rendered, end='')
    return 0 if result['passed'] else 1


if __name__ == '__main__':
    raise SystemExit(main())
