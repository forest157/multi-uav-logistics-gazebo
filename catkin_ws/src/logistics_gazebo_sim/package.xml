<?xml version="1.0"?>
<package format="2">
  <name>logistics_gazebo_sim</name>
  <version>0.4.1</version>
  <description>PX4/ROS/Gazebo Classic 3D simulation for the logistics swarm scenarios.</description>
  <maintainer email="devuser@example.com">devuser</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rospkg</depend>
  <depend>visualization_msgs</depend>
  <depend>std_srvs</depend>
  <depend>rqt_gui</depend>
  <depend>rqt_gui_py</depend>
  <depend>python_qt_binding</depend>
  <depend>rviz</depend>
  <depend>mavros_msgs</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_msgs</depend>
  <depend>ompl</depend>
  <depend>octomap_msgs</depend>
  <depend>nav_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <export><rqt_gui plugin="${prefix}/plugin.xml"/></export>
</package>
