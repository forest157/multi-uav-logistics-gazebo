<launch>
  <arg name="scene_id" default="0"/>
  <arg name="gui" default="true"/>
  <arg name="gazebo_master_uri" default="http://127.0.0.1:11450"/>
  <arg name="mission_config" default="$(find logistics_gazebo_sim)/config/mission_scene0.yaml"/>
  <arg name="auto_start" default="true"/>
  <arg name="target_z" default="5.0"/>
  <arg name="spawn_x" default="-40.0"/>
  <arg name="spawn_y" default="-40.0"/>
  <arg name="spawn_spacing_m" default="3.3"/>
  <arg name="goal_x" default="45.0"/>
  <arg name="goal_y" default="45.0"/>
  <arg name="dynamic_obstacles" default="false"/>
  <arg name="dynamic_avoidance_execution" default="false"/>
  <arg name="vehicle_count" default="3"/>
  <arg name="local_avoidance_algorithm" default="collective_offset"/>
  <arg name="orca_control_mode" default="shadow"/>
  <arg name="orca_command_timeout_s" default="0.6"/>
  <arg name="orca_position_horizon_s" default="0.6"/>
  <arg name="dynamic_obstacle_config" default="$(find logistics_gazebo_sim)/config/dynamic_obstacles_crossing.yaml"/>
  <arg name="dynamic_state_source" default="perception"/>
  <arg name="dynamic_obstacle_state_topic" default="$(eval '/dynamic_obstacles/state' if arg('dynamic_state_source') == 'truth' else '/perception/dynamic_tracks')"/>
  <arg name="lidar_visualization" default="true"/>
  <arg name="lidar_cloud_aggregation" default="true"/>
  <include file="$(find logistics_gazebo_sim)/launch/three_uav_sitl.launch">
    <arg name="scene_id" value="$(arg scene_id)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="target_z" value="$(arg target_z)"/>
    <arg name="gazebo_master_uri" value="$(arg gazebo_master_uri)"/>
    <arg name="spawn_x" value="$(arg spawn_x)"/><arg name="spawn_y" value="$(arg spawn_y)"/>
    <arg name="spawn_spacing_m" value="$(arg spawn_spacing_m)"/>
  </include>
  <node if="$(arg dynamic_obstacles)" pkg="logistics_gazebo_sim" type="dynamic_risk_monitor"
        name="dynamic_risk_monitor" output="screen">
    <env name="OPENBLAS_NUM_THREADS" value="1"/>
    <env name="OMP_NUM_THREADS" value="1"/>
    <param name="vehicle_count" value="$(arg vehicle_count)"/><param name="scene_id" value="$(arg scene_id)"/><param name="spawn_x" value="$(arg spawn_x)"/><param name="spawn_y" value="$(arg spawn_y)"/><param name="spawn_spacing_m" value="$(arg spawn_spacing_m)"/>
    <param name="horizon_s" value="8.0"/><param name="minimum_separation_m" value="3.0"/>
    <param name="warning_clearance_m" value="8.0"/>
    <param name="max_deceleration_mps2" value="1.0"/><param name="control_delay_s" value="0.6"/>
    <param name="braking_margin_s" value="0.4"/><param name="critical_ttc_min_s" value="1.0"/><param name="critical_ttc_max_s" value="8.0"/>
    <param name="risk_release_delay_s" value="0.8"/>
    <param name="local_avoidance_algorithm" value="$(arg local_avoidance_algorithm)"/>
    <param name="obstacle_state_topic" value="$(arg dynamic_obstacle_state_topic)"/>
  </node>
  <group if="$(eval arg('dynamic_obstacles') and arg('dynamic_state_source') == 'perception')">
    <node pkg="logistics_gazebo_sim" type="dynamic_obstacle_sensor_bridge" name="dynamic_obstacle_sensor_bridge" output="screen">
      <param name="vehicle_count" value="$(arg vehicle_count)"/>
      <param name="spawn_x" value="$(arg spawn_x)"/><param name="spawn_y" value="$(arg spawn_y)"/>
      <param name="spawn_spacing_m" value="$(arg spawn_spacing_m)"/>
      <param name="maximum_range_m" value="35.0"/><param name="position_noise_stddev_m" value="0.12"/>
      <param name="dropout_probability" value="0.03"/><param name="latency_s" value="0.10"/>
    </node>
    <node pkg="logistics_gazebo_sim" type="dynamic_target_tracker" name="dynamic_target_tracker" output="screen">
      <param name="alpha" value="0.75"/><param name="beta" value="0.2"/><param name="maximum_age_s" value="1.5"/><param name="occlusion_confidence_decay_per_s" value="0.7"/><param name="minimum_occluded_confidence" value="0.15"/>
    </node>
    <node pkg="logistics_gazebo_sim" type="perception_visualizer" name="perception_visualizer" output="screen"/>
  </group>
  <group if="$(eval arg('dynamic_obstacles') and arg('dynamic_state_source') == 'lidar')">
    <node pkg="logistics_gazebo_sim" type="lidar_dynamic_detector" name="lidar_dynamic_detector" output="screen">
      <param name="vehicle_count" value="$(arg vehicle_count)"/><param name="spawn_x" value="$(arg spawn_x)"/><param name="spawn_y" value="$(arg spawn_y)"/><param name="spawn_spacing_m" value="$(arg spawn_spacing_m)"/>
      <param name="ground_filter_z" value="0.7"/><param name="warmup_frames" value="8"/><param name="voxel_size_m" value="0.45"/><param name="background_hits" value="4"/>
      <param name="cluster_tolerance_m" value="0.9"/><param name="association_distance_m" value="1.8"/><param name="confirmation_hits" value="4"/><param name="maximum_misses" value="3"/><param name="maximum_association_age_s" value="1.5"/><param name="minimum_motion_speed_mps" value="1.5"/><param name="maximum_motion_speed_mps" value="12.0"/><param name="minimum_motion_direction_cosine" value="0.7"/><param name="maximum_motion_acceleration_mps2" value="5.0"/><param name="minimum_cluster_points" value="8"/><param name="maximum_target_radius_m" value="1.4"/><param name="maximum_target_height_m" value="2.0"/>
    </node>
    <node pkg="logistics_gazebo_sim" type="dynamic_target_tracker" name="dynamic_target_tracker" output="screen">
      <param name="alpha" value="0.75"/><param name="beta" value="0.2"/><param name="maximum_age_s" value="1.5"/><param name="occlusion_confidence_decay_per_s" value="0.7"/><param name="minimum_occluded_confidence" value="0.15"/>
    </node>
    <node pkg="logistics_gazebo_sim" type="perception_visualizer" name="perception_visualizer" output="screen"/>
  </group>
  <node if="$(arg lidar_cloud_aggregation)" pkg="logistics_gazebo_sim" type="lidar_cloud_aggregator" name="lidar_cloud_aggregator" output="screen">
    <param name="vehicle_count" value="$(arg vehicle_count)"/><param name="spawn_x" value="$(arg spawn_x)"/><param name="spawn_y" value="$(arg spawn_y)"/><param name="spawn_spacing_m" value="$(arg spawn_spacing_m)"/>
  </node>
  <node if="$(arg dynamic_obstacles)" pkg="logistics_gazebo_sim"
        type="dynamic_avoidance_planner" name="dynamic_avoidance_planner" output="screen" respawn="true">
    <env name="OPENBLAS_NUM_THREADS" value="1"/>
    <env name="OMP_NUM_THREADS" value="1"/>
    <param name="algorithm" value="$(arg local_avoidance_algorithm)"/>
  </node>
  <include if="$(arg dynamic_obstacles)" file="$(find logistics_gazebo_sim)/launch/dynamic_obstacles.launch">
    <arg name="config" value="$(arg dynamic_obstacle_config)"/>
    <arg name="expected_vehicle_count" value="$(arg vehicle_count)"/>
  </include>
  <node pkg="logistics_gazebo_sim" type="fleet_mission_player" name="fleet_mission_player" output="screen">
    <param name="config" value="$(arg mission_config)"/>
    <param name="spawn_spacing_m" value="$(arg spawn_spacing_m)"/>
    <param name="auto_start" value="$(arg auto_start)"/>
    <param name="dynamic_safety_enabled" value="$(arg dynamic_obstacles)"/>
    <param name="dynamic_avoidance_execution" value="$(arg dynamic_avoidance_execution)"/>
    <param name="local_avoidance_algorithm" value="$(arg local_avoidance_algorithm)"/>
    <param name="orca_control_mode" value="$(arg orca_control_mode)"/>
    <param name="orca_command_timeout_s" value="$(arg orca_command_timeout_s)"/>
    <param name="orca_position_horizon_s" value="$(arg orca_position_horizon_s)"/>
    <param name="prediction_horizon_s" value="8.0"/>
    <param name="avoidance_confirmation_s" value="0.6"/>
    <param name="avoidance_apply_s" value="4.0"/>
    <param name="avoidance_recover_s" value="4.0"/>
    <param name="dynamic_warning_scale" value="0.35"/>
    <param name="dynamic_release_delay_s" value="2.0"/>
    <param name="perception_stale_hold_delay_s" value="2.0"/>
    <param name="safety_hold_separation_m" value="2.7"/>
    <param name="safety_release_separation_m" value="3.0"/>
    <param name="safety_release_delay_s" value="1.0"/>
  </node>
  <node pkg="logistics_gazebo_sim" type="fleet_safety_monitor" name="fleet_safety_monitor" output="screen">
    <param name="vehicle_count" value="$(arg vehicle_count)"/><param name="scene_id" value="$(arg scene_id)"/>
    <param name="min_separation" value="2.2"/><param name="min_obstacle_clearance" value="1.0"/>
    <param name="max_tracking_error" value="2.0"/>
    <param name="spawn_x" value="$(arg spawn_x)"/><param name="spawn_y" value="$(arg spawn_y)"/><param name="spawn_spacing_m" value="$(arg spawn_spacing_m)"/>
  </node>
  <node pkg="logistics_gazebo_sim" type="fleet_visualizer" name="fleet_visualizer" output="screen"><param name="vehicle_count" value="$(arg vehicle_count)"/><param name="scene_id" value="$(arg scene_id)"/><param name="spawn_x" value="$(arg spawn_x)"/><param name="spawn_y" value="$(arg spawn_y)"/><param name="spawn_spacing_m" value="$(arg spawn_spacing_m)"/></node>
  <node pkg="logistics_gazebo_sim" type="mission_recorder" name="mission_recorder" output="screen"><param name="vehicle_count" value="$(arg vehicle_count)"/></node>
  <node pkg="logistics_gazebo_sim" type="parcel_delivery_manager" name="parcel_delivery_manager" output="screen"><param name="vehicle_count" value="$(arg vehicle_count)"/></node>
  <node pkg="logistics_gazebo_sim" type="gazebo_marker_sync" name="gazebo_marker_sync" output="screen"><param name="start_x" value="$(arg spawn_x)"/><param name="start_y" value="$(arg spawn_y)"/><param name="goal_x" value="$(arg goal_x)"/><param name="goal_y" value="$(arg goal_y)"/></node>
</launch>
