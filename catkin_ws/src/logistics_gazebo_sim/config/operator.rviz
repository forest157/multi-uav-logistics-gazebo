Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 40
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Ground Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 30
      Color: 100; 100; 105
    - Class: rviz/MarkerArray
      Name: Fleet and Scene
      Enabled: true
      Marker Topic: /fleet/markers
      Queue Size: 10
    - Class: rviz/MarkerArray
      Name: Scene and Selection Preview
      Enabled: true
      Marker Topic: /operator/preview_markers
      Queue Size: 10
    - Class: rviz/PointCloud2
      Name: 3D Lidar Points
      Enabled: true
      Topic: /perception/lidar_points
      Queue Size: 2
      Size (Pixels): 3
      Style: Points
      Color Transformer: FlatColor
      Color: 40; 210; 255
      Decay Time: 0.3
    - Class: rviz/MarkerArray
      Name: Perception Tracks and Velocity
      Enabled: true
      Marker Topic: /perception/dynamic_markers
      Queue Size: 5
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/PublishPoint
      Topic: /clicked_point
      Single click: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 135
      Focal Point: 0; 0; 0
      Pitch: 0.65
      Yaw: 0.75
Window Geometry:
  Height: 800
  Width: 1200
