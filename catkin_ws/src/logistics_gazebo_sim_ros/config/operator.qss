QWidget { background-color: #10151d; color: #e7edf5; font-family: "Noto Sans CJK SC"; font-size: 13px; }
QLabel#title { color: #f7fbff; font-size: 22px; font-weight: 700; padding: 4px 0; }
QLabel#subtitle { color: #8fa2b8; font-size: 12px; padding-bottom: 8px; }
QLabel#statusBadge { background: #1d2938; border: 1px solid #33465e; border-radius: 6px; padding: 6px 10px; font-weight: 600; }
QGroupBox { background: #151d28; border: 1px solid #29384b; border-radius: 10px; margin-top: 14px; padding: 14px 12px 10px 12px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 6px; color: #9fc6ed; }
QComboBox, QDoubleSpinBox { background: #0d131b; border: 1px solid #34475e; border-radius: 6px; padding: 6px 8px; min-height: 22px; selection-background-color: #2878bd; }
QComboBox:hover, QDoubleSpinBox:hover { border-color: #4e8fc7; }
QPushButton { background: #243247; border: 1px solid #38506b; border-radius: 7px; padding: 7px 12px; font-weight: 600; }
QPushButton:hover { background: #30435d; border-color: #5685ae; }
QPushButton:pressed { background: #182334; }
QPushButton#primary { background: #1677c8; border-color: #3298eb; color: white; padding: 9px 16px; }
QPushButton#primary:hover { background: #2189dc; }
QPushButton#danger { background: #9d3038; border-color: #cc4d56; color: white; }
QPushButton#danger:hover { background: #bc3b45; }
QPushButton#secondary { background: #394454; color: #d5deea; }
QProgressBar { background: #0c1219; border: 1px solid #34475e; border-radius: 7px; height: 18px; text-align: center; color: white; font-weight: 600; }
QProgressBar::chunk { border-radius: 6px; background: #2d9cdb; }
QMessageBox { background: #151d28; }
