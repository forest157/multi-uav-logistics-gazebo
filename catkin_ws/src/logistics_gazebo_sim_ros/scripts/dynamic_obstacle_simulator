#!/usr/bin/env python3
"""Spawn deterministic moving collision objects and publish their state."""
import json
import math

import rospy
import yaml
from gazebo_msgs.msg import ModelState
from gazebo_msgs.srv import DeleteModel, SetModelState, SpawnModel
from geometry_msgs.msg import Pose
from std_msgs.msg import String
from visualization_msgs.msg import Marker, MarkerArray


def model_xml(name, radius, height, colour):
    """A bird silhouette with a conservative spherical collision body."""
    return """<?xml version="1.0"?><sdf version="1.6"><model name="{name}">
<static>true</static><link name="bird"><collision name="collision"><geometry>
<sphere><radius>{radius}</radius></sphere></geometry></collision>
<visual name="body"><geometry><box><size>1.35 0.42 0.38</size></box></geometry><material><ambient>{colour}</ambient><diffuse>{colour}</diffuse></material></visual>
<visual name="left_wing"><pose>0 0.72 0.08 0.18 0 -0.18</pose><geometry><box><size>0.9 1.35 0.10</size></box></geometry><material><ambient>{colour}</ambient><diffuse>{colour}</diffuse></material></visual>
<visual name="right_wing"><pose>0 -0.72 0.08 -0.18 0 0.18</pose><geometry><box><size>0.9 1.35 0.10</size></box></geometry><material><ambient>{colour}</ambient><diffuse>{colour}</diffuse></material></visual>
<visual name="beak"><pose>0.82 0 0 0 0 0</pose><geometry><box><size>0.32 0.18 0.16</size></box></geometry><material><ambient>0.95 0.55 0.08 1</ambient><diffuse>0.95 0.55 0.08 1</diffuse></material></visual>
</link></model></sdf>""".format(name=name, radius=radius, height=height, colour=colour)


class DynamicObstacleSimulator:
    def __init__(self):
        config_path = rospy.get_param("~config")
        with open(config_path, "r", encoding="utf-8") as stream:
            config = yaml.safe_load(stream) or {}
        self.rate_hz = float(config.get("rate_hz", 10.0))
        self.frame_id = str(config.get("frame_id", "map"))
        self.items = []
        for raw in config.get("obstacles", []):
            item = {
                "id": str(raw["id"]),
                "start": [float(v) for v in raw["start"]],
                "end": [float(v) for v in raw["end"]],
                "speed": float(raw["speed_mps"]),
                "radius": float(raw["radius_m"]),
                "height": float(raw["height_m"]),
                "phase": float(raw.get("phase_s", 0.0)),
                "colour": str(raw.get("colour", "1.0 0.65 0.05 1")),
                "bob_amplitude": float(raw.get("bob_amplitude_m", 0.2)),
                "bob_period": float(raw.get("bob_period_s", 2.5)),
            }
            if len(item["start"]) != 3 or len(item["end"]) != 3:
                raise ValueError("dynamic obstacle start/end must contain xyz")
            distance = math.sqrt(sum((b-a)**2 for a,b in zip(item["start"],item["end"])))
            if item["speed"] <= 0.0 or distance <= 0.0:
                raise ValueError("dynamic obstacle requires positive speed and path length")
            item["distance"], item["leg_duration"] = distance, distance/item["speed"]
            self.items.append(item)
        self.state_pub = rospy.Publisher("/dynamic_obstacles/state", String, queue_size=5)
        self.marker_pub = rospy.Publisher("/dynamic_obstacles/markers", MarkerArray,
                                          queue_size=2, latch=True)
        rospy.wait_for_service("/gazebo/spawn_sdf_model", timeout=60.0)
        rospy.wait_for_service("/gazebo/set_model_state", timeout=60.0)
        self.spawn = rospy.ServiceProxy("/gazebo/spawn_sdf_model", SpawnModel)
        self.move = rospy.ServiceProxy("/gazebo/set_model_state", SetModelState)
        self.delete = rospy.ServiceProxy("/gazebo/delete_model", DeleteModel)
        self.spawn_all()
        self.started = rospy.Time.now()
        rospy.on_shutdown(self.cleanup)

    def sample(self, item, elapsed):
        phase = (elapsed + item["phase"]) % (2.0 * item["leg_duration"])
        forward = phase <= item["leg_duration"]
        ratio = phase/item["leg_duration"] if forward else 2.0-phase/item["leg_duration"]
        direction = 1.0 if forward else -1.0
        position = [a+(b-a)*ratio for a,b in zip(item["start"],item["end"])]
        velocity = [direction*(b-a)/item["distance"]*item["speed"]
                    for a,b in zip(item["start"],item["end"])]
        bob_angle = 2.0*math.pi*(elapsed+item["phase"])/max(0.5,item["bob_period"])
        position[2] += item["bob_amplitude"]*math.sin(bob_angle)
        velocity[2] += item["bob_amplitude"]*2.0*math.pi/max(0.5,item["bob_period"])*math.cos(bob_angle)
        return position, velocity

    def spawn_all(self):
        for item in self.items:
            pose = Pose();pose.position.x,pose.position.y,pose.position.z=item["start"]
            pose.orientation.w = 1.0
            result = self.spawn(item["id"], model_xml(item["id"], item["radius"],
                                item["height"], item["colour"]), "", pose, "world")
            if not result.success and "already exists" not in result.status_message.lower():
                raise RuntimeError("spawn {}: {}".format(item["id"], result.status_message))

    def marker(self, index, item, position, velocity):
        marker = Marker();marker.header.frame_id=self.frame_id;marker.header.stamp=rospy.Time.now()
        marker.ns="dynamic_obstacles";marker.id=index;marker.type=Marker.SPHERE;marker.action=Marker.ADD
        marker.pose.position.x,marker.pose.position.y,marker.pose.position.z=position
        yaw=math.atan2(velocity[1],velocity[0]);marker.pose.orientation.z=math.sin(yaw*.5);marker.pose.orientation.w=math.cos(yaw*.5)
        marker.scale.x=1.35;marker.scale.y=2.7;marker.scale.z=.38
        marker.color.r=.16;marker.color.g=.20;marker.color.b=.24;marker.color.a=.9
        marker.text="{} v={:.1f}m/s".format(item["id"],math.sqrt(sum(v*v for v in velocity)))
        return marker

    def run(self):
        rate=rospy.Rate(self.rate_hz)
        while not rospy.is_shutdown():
            elapsed=(rospy.Time.now()-self.started).to_sec();states=[];markers=MarkerArray()
            for index,item in enumerate(self.items):
                position,velocity=self.sample(item,elapsed)
                state=ModelState();state.model_name=item["id"];state.reference_frame="world"
                state.pose.position.x,state.pose.position.y,state.pose.position.z=position
                yaw=math.atan2(velocity[1],velocity[0])
                state.pose.orientation.z=math.sin(yaw*.5)
                state.pose.orientation.w=math.cos(yaw*.5)
                result=self.move(state)
                if not result.success:rospy.logwarn_throttle(2.0,"move %s: %s",item["id"],result.status_message)
                states.append({"id":item["id"],"position":[round(v,4) for v in position],
                               "velocity":[round(v,4) for v in velocity],
                               "radius":item["radius"],"height":item["height"]})
                markers.markers.append(self.marker(index,item,position,velocity))
            payload={"stamp":round(rospy.Time.now().to_sec(),4),"frame_id":self.frame_id,
                     "obstacles":states}
            self.state_pub.publish(json.dumps(payload,separators=(",",":")))
            self.marker_pub.publish(markers)
            try: rate.sleep()
            except rospy.ROSInterruptException: break

    def cleanup(self):
        for item in self.items:
            try:self.delete(item["id"])
            except rospy.ServiceException:pass


if __name__ == "__main__":
    rospy.init_node("dynamic_obstacle_simulator")
    DynamicObstacleSimulator().run()
