#!/usr/bin/env python3
"""CLI for deterministic 3D formation-clearance checks."""
import argparse
import json
import sys

import numpy as np
import yaml

from logistics_gazebo_sim_ros.clearance_analyzer import (
    analyze_candidates, analyze_path)
from logistics_gazebo_sim_ros.formation_3d import FORMATION_NAMES
from logistics_gazebo_sim_ros.scenes import SCENES, metric_xy


def default_path(scene_id, altitude):
    scene = SCENES[scene_id]
    start = metric_xy(scene["start"])
    goal = metric_xy(scene["goal"])
    return np.asarray([[start[0], start[1], altitude],
                       [goal[0], goal[1], altitude]], dtype=float)


def main():
    parser = argparse.ArgumentParser(
        description="Analyze whether a 3D centre path can contain a formation")
    parser.add_argument("--scene", type=int, required=True)
    parser.add_argument("--path-csv",
                        help="CSV containing x,y,z centre-path samples")
    parser.add_argument("--altitude", type=float, default=8.0)
    parser.add_argument("--formation", choices=FORMATION_NAMES,
                        default="triangle")
    parser.add_argument("--candidate-formations", nargs="+",
                        choices=FORMATION_NAMES)
    parser.add_argument("--vehicle-count", type=int, default=3)
    parser.add_argument("--spacing", type=float, default=3.0)
    parser.add_argument("--sample-step", type=float, default=0.5)
    parser.add_argument("--output")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    if args.scene not in SCENES:
        report = {"feasible": False, "error_code": "E_SCENE",
                  "message": "场景编号无效"}
    else:
        path = (np.loadtxt(args.path_csv, delimiter=",", ndmin=2)
                if args.path_csv else default_path(args.scene, args.altitude))
        if args.candidate_formations:
            report = analyze_candidates(
                args.scene, path, args.candidate_formations,
                args.vehicle_count, args.spacing, args.sample_step)
        else:
            report = analyze_path(
                args.scene, path, args.formation, args.vehicle_count,
                args.spacing, args.sample_step)

    text = (json.dumps(report, ensure_ascii=False, indent=2)
            if args.json else yaml.safe_dump(
                report, allow_unicode=True, sort_keys=False))
    if args.output:
        with open(args.output, "w", encoding="utf-8") as stream:
            stream.write(text)
    else:
        print(text, end="" if text.endswith("\n") else "\n")
    return 0 if report["feasible"] else 2


if __name__ == "__main__":
    sys.exit(main())
