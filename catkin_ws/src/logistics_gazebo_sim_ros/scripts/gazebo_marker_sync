#!/usr/bin/env python3
"""Move Gazebo start/goal zone models to operator-selected coordinates."""
import rospy
from gazebo_msgs.msg import ModelState
from gazebo_msgs.srv import SetModelState
def move(proxy,name,x,y):
    state=ModelState();state.model_name=name;state.reference_frame="world";state.pose.position.x=x;state.pose.position.y=y;state.pose.position.z=-0.009;state.pose.orientation.w=1.0
    result=proxy(state)
    if not result.success:raise RuntimeError("{}: {}".format(name,result.status_message))
if __name__=="__main__":
    rospy.init_node("gazebo_marker_sync")
    rospy.wait_for_service("/gazebo/set_model_state",timeout=60.0);proxy=rospy.ServiceProxy("/gazebo/set_model_state",SetModelState)
    try:
        move(proxy,"start_zone",float(rospy.get_param("~start_x")),float(rospy.get_param("~start_y")))
        move(proxy,"goal_zone",float(rospy.get_param("~goal_x")),float(rospy.get_param("~goal_y")))
        rospy.loginfo("Gazebo start/goal zones synchronized")
    except (rospy.ServiceException,RuntimeError) as exc:
        rospy.logerr("Failed to synchronize Gazebo zones: %s",exc);raise
